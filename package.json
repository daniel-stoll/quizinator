{
  "name": "quizinator",
  "version": "1.0.0",
  "description": "Express Node.js server with Socket.io and TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon src/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build && tsc",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node dist/index.js"
  },
  "nodemonConfig": {
    "ignore": ["data/*"]
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "license": "MIT"
}
